{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "d1:create": "wrangler d1 create skinvault_leads",
    "d1:schema": "wrangler d1 execute skinvault_leads --file=d1/schema.sql",
    "d1:list": "wrangler d1 execute skinvault_leads --command=\"SELECT * FROM leads ORDER BY id DESC LIMIT 20;\"",
    "d1:csv": "wrangler d1 execute skinvault_leads --command=\"SELECT * FROM leads ORDER BY id DESC;\" --json | jq -r",
    "pages:dev": "wrangler pages dev dist --d1=LEADS_DB=skinvault_leads --compatibility-date=2024-08-01"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
